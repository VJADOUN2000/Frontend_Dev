//confusion topics

function getGrade(score){
    if (score>=90 && score<=100) return "A+"
    else if(score>=80 && score<=89) return "A"
    else if(score>=70 && score<=79) return "B"
    else if(score>=60 && score<=69) return "C"
    else if(score>=33 && score<=59) return "D"
    else if(score>=0 && score<=32) return "Fail"
    else return "Invalid marks"
}

console.log(getGrade(687));


//rock paper-scissors logic

function rps(user, computer){
    if(user =="rock" && computer =="scissor") return "User Win";
    else if(user =="paper" && computer =="rock") return "User Win";
    else if (user =="scissor" && computer =="paper") return "User Win";
    return "Computer Wins"
}

console.log(rps("paper","scissor"));